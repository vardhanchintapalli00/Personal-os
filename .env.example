# PostgreSQL (local docker, Supabase, Neon, Railway, ...). For Supabase use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Optional Google login (create OAuth credentials in Google Cloud Console;
# redirect URI: {NEXTAUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"
